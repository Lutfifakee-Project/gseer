# GSEER — example environment (v0.3.2, Linux-only).
#
# Copy to `.env` and fill in, OR let `gseer setup --with-compose`
# generate the real `.env` with a cryptographically-random password.
# Never commit a real `.env` — `.gitignore` excludes it.
#
# Precedence (highest wins; see internal/config/loader.go):
#   CLI flags  >  environment variables (this file)  >  YAML config file  >  built-in defaults
#
# Env vars set to an empty string are treated as UNSET (except
# GSEER_DB_PASSWORD where an explicitly-set empty value is meaningful
# for trust-auth dev setups).

# ─── State location ──────────────────────────────────────────────────────
# Portable state directory: when set, the config file and personal-mode
# state live under it instead of ~/.gseer (docs/QUICKSTART.md).
# GSEER_HOME=

# ─── Profile ─────────────────────────────────────────────────────────────
# personal | self-hosted.  Default: personal (the zero-config product
# default — one SQLite Local Index file; no PostgreSQL needed).
# Switch to self-hosted for the headless CLI over PostgreSQL.
# GSEER_PROFILE=personal

# ─── Config file location ────────────────────────────────────────────────
# Default: ~/.gseer/config.yaml (or $GSEER_HOME/config.yaml when set).
# Override with --config flag or GSEER_CONFIG env var.
# GSEER_CONFIG=/path/to/config.yaml

# ─── Central dataset + signed updates (https channels) ───────────────────
# Overrides for the two signed/verified channels.  Leave unset to use the
# project defaults (docs/DATASET.md, docs/UPDATE.md).
# GSEER_DATASET_MANIFEST_URL=
# GSEER_UPDATE_MANIFEST_URL=

# ─── PostgreSQL (self-hosted profile; PostgreSQL 16+ enforced; the compose
#     template ships postgres:17-alpine) ──────────────────────────────────
# Loopback-only by default; docker-compose.yml binds 127.0.0.1:5432.
# `gseer setup --with-compose` generates GSEER_DB_PASSWORD with:
#   openssl rand -hex 24
# Do NOT use the placeholder below in any real deployment.
GSEER_DB_USER=gseer
GSEER_DB_PASSWORD=CHANGE_ME_generated_by_setup_with_compose
GSEER_DB_NAME=gseer
GSEER_DB_HOST=127.0.0.1
GSEER_DB_PORT=5432
# SSL mode: disable (loopback) | require | verify-ca | verify-full.
# Non-loopback deployments MUST use require or verify-full.
GSEER_DB_SSLMODE=disable

# Full DSN (overrides the component fields above when set).
# Format: postgres://user:password@host:port/dbname?sslmode=disable
# GSEER_DB_DSN=

# ─── Runtime credential (the least-privilege `gseer_app` role) ───────────
# Provisioned by `gseer setup --self-hosted`
# (bootstrap → migrate → grants → audit).  The setup command PRINTS this
# DSN exactly once (random password); rotate anytime with
# `gseer setup --self-hosted --reset-runtime-password`.  Data-plane CLI
# commands (search/export/collect/suppress/source/host) prefer it and
# print an explicit notice when falling back to the operator credential
# (docs/DEPLOYMENT.md).
# GSEER_DB_RUNTIME_DSN=postgres://gseer_app:<password>@127.0.0.1:5432/gseer?sslmode=disable
#
# NOTE on key names: `gseer setup --with-compose` writes the host-side
# convenience key `GSEER_DSN=` into the generated .env (consumed via
# `grep '^GSEER_DSN='` in the quickstart).  The config layer itself
# reads `GSEER_DB_DSN` (above) — export one into the other when handing
# a session over to self-hosted mode (docs/QUICKSTART.md).
#
# `gseer setup --with-compose --full` additionally writes
# `GSEER_APP_PASSWORD=` into the generated .env — the password for the
# least-privilege `gseer_app` role consumed by the docker-compose.full.yml
# provision container (docs/DOCKER.md).
# GSEER_APP_PASSWORD=

# Migration advisory-lock timeout (milliseconds).
# How long `gseer setup --self-hosted` waits for the golang-migrate
# advisory lock before failing with DB_MIGRATION_LOCK_TIMEOUT (never
# hangs).  Range: 1000..300000.
GSEER_DB_MIGRATION_LOCK_TIMEOUT_MS=30000

# ─── Logging ─────────────────────────────────────────────────────────────
GSEER_LOG_LEVEL=info   # debug | info | warn | error
GSEER_LOG_FORMAT=text  # text | json

# ─── Fingerprint rules ───────────────────────────────────────────────────
# Operator-supplied fingerprint rules directory and kill switch
# (docs/RULES.md).
# GSEER_FINGERPRINTS_RULES_DIR=
# GSEER_FINGERPRINTS_DISABLED=false

# Fixture evaluation gate.  Default: false on non-dev installs.
# When false, `gseer setup --load-fixtures` is refused with a confirmation
# prompt; when true, the prompt is skipped (dev profile only).
GSEER_POLICY_EVALUATION_FIXTURES=false

# ═══ Keys NOT accepted ═══════════════════════════════════════════════════
# Any `policy.active.*` key is REJECTED by config validation with
# E_CONFIG_POLICY_ACTIVE_REJECTED.  Active collection is not part of any
# release until its authorization gates close; shipped defaults are
# engineering values only, not authorization to scan.  Passive
# collection is explicit and operator-driven: gseer source add
# → gseer source enable → gseer collect run.  The rejection is
# normative, not a missing feature.
#
# Similarly rejected:
#   - insecure_skip_verify / InsecureSkipVerify (E_CONFIG_INSECURE)
#   - Any unknown YAML key not in the documented schema (E_CONFIG_UNKNOWN_KEY)
